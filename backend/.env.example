# Copie este arquivo para ".env" e preencha os valores.
# NUNCA versione o .env real (ele está no .gitignore).

# Porta do servidor
PORT=3001

# Provedor de IA de visão. Opções: openai | gemini
IA_PROVIDER=gemini

# Chave da API do provedor escolhido.
# OpenAI:  https://platform.openai.com/api-keys
# Gemini:  https://aistudio.google.com/app/apikey
IA_API_KEY=coloque_sua_chave_aqui

# Modelo (opcional). Padrões:
#   openai -> gpt-4o-mini
#   gemini -> gemini-flash-lite-latest (mais estável no plano grátis)
IA_MODEL=gemini-flash-lite-latest

# ===== Supabase (para validar o token dos usuários no backend) =====
# URL do projeto (Project URL no painel) e a publishable/anon key.
# A mesma key usada no frontend (supabaseClient.js).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# SECRET KEY (service_role) — Project Settings > API > service_role.
# PODEROSA: ignora RLS e dá acesso total. SÓ no backend, NUNCA no frontend/Git.
# Necessária para excluir contas (LGPD).
SUPABASE_SERVICE_KEY=cole_a_service_role_key_aqui

# Origens permitidas para CORS (separadas por vírgula).
# Vazio = same-origin (o backend serve o próprio frontend). Ok para dev.
# Em produção, liste o(s) domínio(s) reais:
#   CORS_ORIGIN=https://meuapp.com,https://www.meuapp.com
CORS_ORIGIN=
